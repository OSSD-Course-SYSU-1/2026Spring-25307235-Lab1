                      this.fontWeight = this.fontWeights[index]; // å°†é€‰ä¸­é¡¹èµ‹å€¼ç»™fontWeight
                      this.selectedIndex = index; // å°†é€‰ä¸­é¡¹çš„ç´¢å¼•èµ‹å€¼ç»™selectedIndex
                    })
                }
